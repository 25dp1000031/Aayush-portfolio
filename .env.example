# ── Portfolio Environment Variables ──────────────────────────────────────
# Rename this file to .env.local and fill in your values.
# .env.local is git-ignored — NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (primary backend) ────────────────────────────────────────────
# 1. Create a project at https://supabase.com/
# 2. Settings → API → copy Project URL and anon/public key
#
# Required tables (run once in Supabase SQL editor):
#
#   -- Content store: single row keyed by fixed UUID
#   CREATE TABLE portfolio_content (
#     id          uuid PRIMARY KEY DEFAULT '00000000-0000-0000-0000-000000000001',
#     hero        jsonb,
#     github      jsonb,
#     experience  jsonb,
#     metrics     jsonb,
#     updated_at  timestamptz DEFAULT now()
#   );
#
#   -- Contact form submissions
#   CREATE TABLE contact_messages (
#     id         uuid DEFAULT gen_random_uuid() PRIMARY KEY,
#     from_name  text NOT NULL,
#     from_email text NOT NULL,
#     subject    text,
#     message    text NOT NULL,
#     created_at timestamptz DEFAULT now()
#   );
#
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── EmailJS (fallback contact form — active when Supabase is not set) ─────
# 1. Sign up at https://www.emailjs.com/ (free tier: 200 emails/month)
# 2. Create a Service → copy Service ID
# 3. Create an Email Template → copy Template ID
# 4. Account → API Keys → copy Public Key
#
# Template variables used: {{from_name}}, {{from_email}},
#                          {{subject}}, {{message}}, {{to_name}}
#
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Edge Function secrets (configure in Supabase dashboard, NOT here) ─────
# Dashboard → Edge Functions → contact-handler → Secrets:
#   RESEND_API_KEY  = re_xxxxxxxxxxxx
#   NOTIFY_TO       = aayushkukade@gmail.com
#   NOTIFY_FROM     = portfolio@yourdomain.com
